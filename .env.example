# Host directory containing processed campus telemetry. The default resolves to
# /home/xcurv/teep-taiwan/data when Compose runs from this repository.
TEEP_DATA_DIR=../data

EMS_DASHBOARD_PORT=8501
SIMULATOR_PORT=8003
SIMULATOR_PUBLIC_URL=http://localhost:8003
NATS_MONITOR_PORT=8222
NATS_PORT=4222
# Internal URL used by the dashboard's read-only message observer.
NATS_URL=nats://nats:4222
# Internal URL used by the dashboard's human-readable service map.
NATS_MONITOR_URL=http://nats:8222
